APP_NAME=PrithviQ API
APP_ENV=development
API_PREFIX=/api/v1
ALLOWED_ORIGINS=http://localhost:5173
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=prithviq-api
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
DATABASE_URL=
REDIS_URL=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=prithviq-private
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
MODEL_REGISTRY_URL=
MODEL_REGISTRY_TOKEN=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=PrithviQ/1.0 contact@example.com
SENTRY_DSN=

# Demo milestone (deterministic in-memory lifecycle, api.md section 11)
MAX_UPLOAD_BYTES=1073741824
DEMO_MODE=true
STRICT_PAIR_VALIDATION=false

# Real AI provider (Task 4). 'mock' = deterministic demo worker (default);
# 'gemini' enables real Gemini answer generation with automatic fallback.
# Get a key at https://aistudio.google.com/ — server-side only, NEVER a VITE_ var.
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_S=45
